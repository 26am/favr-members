{
  "name": "favr/core",
  "description": "Shared building blocks for Favr Sites plugins: declarative fields, sanitizing, admin field UI, templates.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "brain/monkey": "^2.6",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": {
    "psr-4": { "FavrCore\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "FavrCore\\Tests\\": "tests/" }
  },
  "config": {
    "platform": { "php": "8.1.0" },
    "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs"
  }
}
