{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "favr-members/members-only",
	"title": "Members Only",
	"category": "design",
	"icon": "lock",
	"description": "Content inside this block is only shown to current members. Everyone else sees a login prompt.",
	"keywords": [
		"members",
		"restrict",
		"private",
		"gate",
		"login"
	],
	"textdomain": "favr-members",
	"attributes": {
		"message": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		]
	},
	"editorStyle": "file:../../assets/blocks/editor.css"
}
